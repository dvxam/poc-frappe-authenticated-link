# ============================================================================
# VIDI SI Platform — environment variables
# Copy to .env and replace ALL secrets before deploying.
#   cp .env.example .env
# ============================================================================

# ---- 1. GoPhish -----------------------------------------------------------
GOPHISH_ADMIN_PORT=3333
GOPHISH_PHISH_PORT=8080
GOPHISH_ADMIN_PASSWORD=change-me-admin
# GoPhish API key (generated in the UI after the first login) — used by Backstage
GOPHISH_API_KEY=

# ---- 2. Frappe LMS --------------------------------------------------------
# Official Frappe LMS image (GitHub Container Registry).
# For reproducibility, pin a version, e.g. ghcr.io/frappe/lms:v2.52.0
FRAPPE_IMAGE=ghcr.io/frappe/lms:v2.65.0
FRAPPE_SITE_NAME=lms.localhost
FRAPPE_PORT=8000
FRAPPE_ADMIN_PASSWORD=change-me-admin
FRAPPE_DB_ROOT_PASSWORD=change-me-root
# Frappe API key/secret (from the frappe-create-service-user one-shot) — used by Backstage
FRAPPE_API_KEY=
FRAPPE_API_SECRET=

# ---- 3. Backstage (Roadie demo image) -------------------------------------
BACKSTAGE_PORT=7007
# GitHub PAT (scopes: repo,user,read:org,read:discussion) to populate the catalog. Optional.
BACKSTAGE_GITHUB_TOKEN=
